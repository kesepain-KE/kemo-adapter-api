# =============================================================================
# Kemo 网关环境配置
# 注意：所有环境变量仅在进程启动时读取，修改后必须重启网关。
# =============================================================================


# ---------------------------------------------------------------------------
# 1. 认证与调用
# ---------------------------------------------------------------------------

# 网关调用密钥统一维护在 api/keys.json；首次部署可直接编辑该文件中的示例密钥。
# 不建议把调用密钥写入环境变量，避免同时维护两套配置。

# 外部智能体只读感知接口 GET /status 的独立 Token。
# 可信内网不需要时留空；启用后必须使用 Authorization: Bearer <STATUS_TOKEN>。
STATUS_TOKEN=


# ---------------------------------------------------------------------------
# 2. Web 管理端
# ---------------------------------------------------------------------------

# Web 管理端用户名和密码，必须同时设置；登录会话有效期为 2 小时。
# 本机/可信家庭局域网：可以暂时留空，网关直接进入 owner 管理页。
# 公网部署：必须填写，并同时填写 WEB_TOKEN，建议使用随机长字符串。
WEB_USERNAME=
WEB_PASSWORD=

# Web 管理端第一阶段 Token；只允许在登录表单中提交，禁止放入 URL。
# Token 预认证会话有效期为 2 小时。
# 与用户名/密码同时设置时，必须先验证 Token，再验证用户名和密码。
# 三项全部为空时网页自动免登录，包括局域网与 0.0.0.0 监听；修改后必须重启。
# 公网部署必须配置 WEB_TOKEN、WEB_USERNAME 和 WEB_PASSWORD 两道鉴权。
WEB_TOKEN=

# 管理会话使用 HttpOnly + SameSite=Strict Cookie，浏览器脚本无法读取。
# auto 会根据当前访问请求的 HTTP/HTTPS scheme 自动设置 Secure；公网建议保留 auto。
# 同一实例同时通过公网 HTTPS 和局域网 HTTP 访问时，auto 会分别适配两种入口。
# 反向代理必须传递 X-Forwarded-Proto；也可以显式设置 true/false。
WEB_COOKIE_SECURE=auto

# 可选 Host 头白名单，逗号分隔且不要写协议、端口或路径。
# 本机/局域网：留空，避免因 IP、主机名变化导致登录失败。
# 公网：填写公网域名；若还要从局域网访问，同时加入局域网 IP/主机名。
WEB_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# 3. 网络与服务
# ---------------------------------------------------------------------------

# 网关监听地址与端口。
# 0.0.0.0 同时支持本机和局域网访问；仅本机使用时可改为 127.0.0.1。
HOST=0.0.0.0
PORT=7531

# 网关向调用方公布的外部 Base URL，仅用于网页展示和复制。
# 本机/局域网：留空即可，网页自动使用当前访问地址。
# 公网反向代理：填写 https://gateway.example.com（不要附加接口路径）。
GATEWAY_BASE_URL=

# uvicorn 日志级别：debug / info / warning / error / critical
LOG_LEVEL=info

# 是否输出 HTTP 访问日志
WEB_ACCESS_LOG=true

# 是否公开 FastAPI /docs、/redoc 与 /openapi.json；公网默认关闭。
API_DOCS_ENABLED=false

# 启动时是否自动打开浏览器管理页面
WEB_OPEN_BROWSER=false


# ---------------------------------------------------------------------------
# 4. 统计与时区
# ---------------------------------------------------------------------------

# 每日调用统计的日期切分时区；数据库时间戳仍统一保存为 UTC。
STATISTICS_TIMEZONE=Asia/Shanghai


# ---------------------------------------------------------------------------
# 5. 优雅重启
# ---------------------------------------------------------------------------

# 排空活跃请求的最大等待秒数（超过后强制关闭）
RESTART_DRAIN_TIMEOUT=120

# 替换进程确认启动成功的最大等待秒数
RESTART_STARTUP_TIMEOUT=60


# ---------------------------------------------------------------------------
# 6. 网络传输稳定性
# ---------------------------------------------------------------------------

# 单个模型请求的网关兜底时限（Provider 自身还会有更细的超时）。
# 超时后返回可重试的 GATEWAY_TIMEOUT，不会无限占用执行槽位。
MODEL_EXECUTION_TIMEOUT_SECONDS=900

# 单进程同时执行的模型请求上限；超过后返回 503，并携带 Retry-After。
MAX_CONCURRENT_EXECUTIONS=64

# SSE 空闲心跳间隔。反向代理/隧道通常需要心跳避免把思考中的连接判定为空闲。
SSE_HEARTBEAT_SECONDS=15

# 执行结果和 SSE 事件的本地保留时间；用于断线重连和相同 request_id 重放。
EXECUTION_RETENTION_HOURS=24

# 单个流式响应最多保留的事件数，避免异常 Provider 无限增长内存和数据库。
MAX_SSE_EVENTS_PER_RESPONSE=200000


# ---------------------------------------------------------------------------
# 7. 媒体资源（Asset）
# ---------------------------------------------------------------------------

# 上传媒体资源的默认过期时间（小时），到期后自动清理
DEFAULT_ASSET_TTL_HOURS=24

# Kemo /model/responses JSON 正文上限（字节，不含 Asset 文件字节）
REQUEST_JSON_MAX_BYTES=2097152

# 单个 Asset 的最大字节数。修改后必须重启网关。
ASSET_IMAGE_MAX_BYTES=20971520
ASSET_AUDIO_MAX_BYTES=104857600
ASSET_VIDEO_MAX_BYTES=1073741824
ASSET_FILE_MAX_BYTES=104857600


# ---------------------------------------------------------------------------
# 8. 厂商 Provider
# ---------------------------------------------------------------------------

# Provider 配置统一放在 providers/<id>/config.json 和 secrets.json，按网页提示保存。
# 不要在这里复制 Provider JSON；这类配置的热更新和密钥隔离由 Provider 目录负责。
