# 所有环境变量仅在进程启动时读取，修改后必须重启网关。

# 启动/应急调用方兼容配置。无需重启的调用密钥放在 api/keys.json。
# GATEWAY_API_KEY=replace-me
# GATEWAY_DEFAULT_TENANT=default
# GATEWAY_DEFAULT_SUBJECT=kemo-agent

# 启动时 Token -> 可信租户/主体/Scope。不要把 metadata.user 当作授权主体。
# GATEWAY_API_KEYS_JSON={"replace-me":{"tenant_id":"tenant-1","subject_id":"agent-1","scopes":["model:invoke","asset:read","asset:write"]}}

# Web 用户认证预留配置。管理 Token 与这两个字段都未设置或为空时，网页自动免登录。
# 只有 admin:web/owner Token 会关闭免登录；普通 model:invoke 调用 Key 不影响网页登录。
WEB_USERNAME=
WEB_PASSWORD=

HOST=127.0.0.1
PORT=8741
LOG_LEVEL=info

# start_web.py 专用启动行为；均需重启后生效。
WEB_ACCESS_LOG=true
WEB_OPEN_BROWSER=false

# 平滑重启超时；restart.py 和网页 owner API 共用，修改后必须重启。
RESTART_DRAIN_TIMEOUT=120
RESTART_STARTUP_TIMEOUT=60

# 启动时厂商配置。无需重启的厂商 API 配置放在 providers/<id>/config.json 和 secrets.json。
# PROVIDER_SETTINGS_JSON={"openai":{"api_key":"...","base_url":"https://api.openai.com/v1"}}

DEFAULT_ASSET_TTL_HOURS=24
