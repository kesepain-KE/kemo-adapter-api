# =============================================================================
# Kemo 网关环境配置
# 注意：所有环境变量仅在进程启动时读取，修改后必须重启网关。
# =============================================================================


# ---------------------------------------------------------------------------
# 1. 认证与调用
# ---------------------------------------------------------------------------

# 首次启动/应急调用方兼容配置：可用单个 Token 最简单地调用网关 API。
# 正式部署或需要热加载时，请改用 api/keys.json。
# GATEWAY_API_KEY=replace-me

# 启动时注入完整密钥表（JSON 字符串），格式同 api/keys.json。
# 此方法与 api/keys.json 互不覆盖，合并生效。
# GATEWAY_API_KEYS_JSON={"replace-me":{"key_id":"kemo-graph-production","tenant_id":"tenant-1","subject_id":"agent-1","scopes":["model:invoke","embedding:invoke","rerank:invoke","asset:read","asset:write"]}}

# 外部智能体只读感知接口 GET /status 的独立 Token。
# 必须通过 Authorization: Bearer <STATUS_TOKEN> 使用；为空时 /status 禁用。
STATUS_TOKEN=


# ---------------------------------------------------------------------------
# 2. Web 管理端
# ---------------------------------------------------------------------------

# Web 管理端用户名和密码，必须同时设置；登录会话有效期为 2 小时。
WEB_USERNAME=
WEB_PASSWORD=

# Web 管理端第一阶段 Token；Token 预认证会话有效期为 2 小时。
# 入口：http://127.0.0.1:7531?token=<WEB_TOKEN>
# 与用户名/密码同时设置时，必须先验证 Token，再验证用户名和密码。
# 三项全部为空时网页自动免登录；修改后必须重启。
WEB_TOKEN=


# ---------------------------------------------------------------------------
# 3. 网络与服务
# ---------------------------------------------------------------------------

# 网关监听地址与端口
HOST=127.0.0.1
PORT=7531

# 网关向调用方公布的外部 Base URL，仅用于网页展示和复制。
# 反向代理或域名部署示例：https://gateway.example.com
# 不要附加 /model/responses 等具体接口路径；为空表示尚未配置。
GATEWAY_BASE_URL=

# uvicorn 日志级别：debug / info / warning / error / critical
LOG_LEVEL=info

# 是否输出 HTTP 访问日志
WEB_ACCESS_LOG=true

# 启动时是否自动打开浏览器管理页面
WEB_OPEN_BROWSER=false


# ---------------------------------------------------------------------------
# 4. 统计与时区
# ---------------------------------------------------------------------------

# 每日调用统计的日期切分时区；数据库时间戳仍统一保存为 UTC。
STATISTICS_TIMEZONE=Asia/Shanghai


# ---------------------------------------------------------------------------
# 5. 优雅重启
# ---------------------------------------------------------------------------

# 排空活跃请求的最大等待秒数（超过后强制关闭）
RESTART_DRAIN_TIMEOUT=120

# 替换进程确认启动成功的最大等待秒数
RESTART_STARTUP_TIMEOUT=60


# ---------------------------------------------------------------------------
# 6. 媒体资源（Asset）
# ---------------------------------------------------------------------------

# 上传媒体资源的默认过期时间（小时），到期后自动清理
DEFAULT_ASSET_TTL_HOURS=24

# Kemo /model/responses JSON 正文上限（字节，不含 Asset 文件字节）
REQUEST_JSON_MAX_BYTES=2097152

# 单个 Asset 的最大字节数。修改后必须重启网关。
ASSET_IMAGE_MAX_BYTES=20971520
ASSET_AUDIO_MAX_BYTES=104857600
ASSET_VIDEO_MAX_BYTES=1073741824
ASSET_FILE_MAX_BYTES=104857600


# ---------------------------------------------------------------------------
# 7. 厂商 Provider
# ---------------------------------------------------------------------------

# 启动时厂商配置（JSON 字符串）。
# 无需重启的厂商 API 配置放在 providers/<id>/config.json 和 secrets.json。
# PROVIDER_SETTINGS_JSON={"openai":{"api_key":"...","base_url":"https://api.openai.com/v1"}}
