# =============================================================================
# Kemo 网关环境配置
# 注意：所有环境变量仅在进程启动时读取，修改后必须重启网关。
# =============================================================================


# ---------------------------------------------------------------------------
# 1. 认证与调用
# ---------------------------------------------------------------------------

# 下游调用密钥在控制台创建，保存到 data/gateway.sqlite3，仅首次显示完整值。
# 若只需要先让一个智能体连通网关，可取消下一行注释并填入随机长 Token；修改后必须重启。
# GATEWAY_API_KEY: ''

# Linux 部署须通过进程环境或系统凭据管理提供 KEMO_MASTER_KEY：
# 32 字节随机值的 Base64 编码。请保管并备份主密钥，不写入源码。
# Windows 未设置时使用当前用户的 DPAPI 保存本地主密钥。

# 外部智能体只读感知接口 GET /status 的独立 Token。
# 可信内网不需要时留空；启用后必须使用 Authorization: Bearer <STATUS_TOKEN>。
STATUS_TOKEN: ''


# ---------------------------------------------------------------------------
# 2. Web 管理端
# ---------------------------------------------------------------------------

# Web 管理端用户名和密码，必须同时设置；登录会话有效期为 2 小时。
# 本机回环访问（推荐默认）：留空即可，127.0.0.1/localhost 会直接进入 owner 管理页。
# 可信局域网可三项都留空；公网必须填写 WEB_TOKEN、WEB_USERNAME 和 WEB_PASSWORD，建议使用随机长字符串。
WEB_USERNAME: ''
WEB_PASSWORD: ''

# Web 管理端第一阶段 Token；只允许在登录表单中提交，禁止放入 URL。
# Token 预认证会话有效期为 2 小时。
# 与用户名/密码同时设置时，必须先验证 Token，再验证用户名和密码。
# 三项全部为空时，回环本机访问自动免登录；局域网免登录仅适合完全可信的内循环环境。
# 公网部署必须配置 WEB_TOKEN、WEB_USERNAME 和 WEB_PASSWORD 两道鉴权。
WEB_TOKEN: ''

# 管理会话使用 HttpOnly + SameSite=Strict Cookie，浏览器脚本无法读取。
# auto 会根据当前访问请求的 HTTP/HTTPS scheme 自动设置 Secure；公网建议保留 auto。
# 同一实例同时通过公网 HTTPS 和局域网 HTTP 访问时，auto 会分别适配两种入口。
# 反向代理必须传递 X-Forwarded-Proto；也可以显式设置 true/false。
WEB_COOKIE_SECURE: auto

# 可选 Host 头白名单，逗号分隔且不要写协议、端口或路径。
# 本机/局域网：留空，避免因 IP、主机名变化导致登录失败。
# 公网：填写公网域名；若还要从局域网访问，同时加入局域网 IP/主机名。
WEB_ALLOWED_HOSTS: ''

# ---------------------------------------------------------------------------
# 3. 网络与服务
# ---------------------------------------------------------------------------

# 网关监听地址与端口。
# 仅本机使用（推荐）：127.0.0.1。需要局域网/公网访问时再改成 0.0.0.0，并配置鉴权。
HOST: 127.0.0.1
PORT: 7531

# 网关向调用方公布的外部 Base URL，仅用于网页展示和复制。
# 本机/局域网：留空即可，网页自动使用当前访问地址。
# 公网反向代理：填写 https://gateway.example.com（不要附加接口路径）。
# 反向代理必须保留外部 Host，或正确传递 X-Forwarded-Host / Forwarded；
# 不要把公网请求统一重写成 127.0.0.1/localhost Host，否则会破坏本机/公网鉴权边界。
GATEWAY_BASE_URL: ''

# uvicorn 日志级别：debug / info / warning / error / critical
LOG_LEVEL: info

# 是否输出 HTTP 访问日志
WEB_ACCESS_LOG: true

# 是否公开 FastAPI /docs、/redoc 与 /openapi.json；公网默认关闭。
API_DOCS_ENABLED: false

# 启动时是否自动打开浏览器管理页面
WEB_OPEN_BROWSER: false


# ---------------------------------------------------------------------------
# 4. 统计与时区
# ---------------------------------------------------------------------------

# 每日调用统计的日期切分时区；数据库时间戳仍统一保存为 UTC。
STATISTICS_TIMEZONE: Asia/Shanghai


# ---------------------------------------------------------------------------
# 5. 优雅重启
# ---------------------------------------------------------------------------

# 排空活跃请求的最大等待秒数，应高于网关执行时限；非强制重启超时后取消重启。
RESTART_DRAIN_TIMEOUT: 1300

# 替换进程确认启动成功的最大等待秒数
RESTART_STARTUP_TIMEOUT: 60


# ---------------------------------------------------------------------------
# 6. 网络传输稳定性
# ---------------------------------------------------------------------------

# 单个模型请求的网关兜底时限（上游连接另有超时）。
# 超时后返回可重试的 GATEWAY_TIMEOUT，不会无限占用执行槽位。
MODEL_EXECUTION_TIMEOUT_SECONDS: 1200

# 单进程同时执行的模型请求上限；超过后返回 503，并携带 Retry-After。
MAX_CONCURRENT_EXECUTIONS: 64

# SSE 空闲心跳间隔。反向代理/隧道通常需要心跳避免把思考中的连接判定为空闲。
SSE_HEARTBEAT_SECONDS: 15

# 每日辅助统计数据库的保留天数；调用摘要、用量和费用记录另行保留。
# 默认 30 天；后台按小批次清理，不阻塞网关启动。
LOG_RETENTION_DAYS: 30

# 完整调用正文、执行结果和 SSE 重放记录的保留小时数。
# 默认 24 小时；后台每 5 分钟清理到期详情，不删除调用摘要、用量和费用。
# 运行中的执行不会被删除；超过保留期后不能再查询或重放完整响应。
LOG_DETAIL_RETENTION_HOURS: 24

# 调用详情记录模式：full 保留全部，errors 仅保留失败/取消，off 不保留正文。
# 默认 full；详情先保存在内存，调用结束后最多写入一次，摘要、用量和费用始终保存。
LOG_DETAIL_MODE: full

# 单条调用日志正文上限（字节，含截断元数据，最小 256），默认 4 MiB。
# 超限仅截断脱敏后的日志预览，标记 truncated/original_bytes，不裁剪实际请求或返回。
LOG_DETAIL_MAX_BYTES: 4194304

# 单个流式响应最多保留的事件数，避免异常 Provider 无限增长内存和数据库。
MAX_SSE_EVENTS_PER_RESPONSE: 200000


# ---------------------------------------------------------------------------
# 7. 媒体资源（Asset）
# ---------------------------------------------------------------------------

# 上传媒体资源的默认过期时间（小时），到期后自动清理
DEFAULT_ASSET_TTL_HOURS: 24

# Kemo 模型接口与管理 API 的 JSON 正文上限，默认 32 MiB，不含 Asset 文件字节。
REQUEST_JSON_MAX_BYTES: 33554432

# 上游非流式 JSON 响应上限，默认 32 MiB；流式单事件仍为 1 MiB。
UPSTREAM_JSON_MAX_BYTES: 33554432

# 单个 Asset 的最大字节数。修改后必须重启网关。
ASSET_IMAGE_MAX_BYTES: 20971520
ASSET_AUDIO_MAX_BYTES: 104857600
ASSET_VIDEO_MAX_BYTES: 1073741824
ASSET_FILE_MAX_BYTES: 104857600


# ---------------------------------------------------------------------------
# 8. 上游与模型目录
# ---------------------------------------------------------------------------

# 上游、模型、Deployment 与密钥策略在控制台管理，持久化到 data/gateway.sqlite3。
# 上游、模型与调用密钥由控制台管理；网关版本单独使用 version.json。
