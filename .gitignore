# 本地密钥与运行配置
.env
api/keys.json
providers/*/secrets.json

# 厂商包由部署端热加载；仓库仅保留 Python 命名空间。
providers/*
!providers/__init__.py

# 开发者私有资料，不上传 GitHub
开发目录/

# 编辑自动备份
*.bak
*.bak.*

# 本地浏览器调试记录
.playwright-cli/

# 更新冷备份
.backup/

# 前端构建产物（克隆后自行构建）
web/frontend/node_modules/
web/frontend/dist/
web/frontend/.runtime/
*.tsbuildinfo

# Python / test caches
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Local runtime state
*.log
*.pid
core/runtime/
storage/daily/
